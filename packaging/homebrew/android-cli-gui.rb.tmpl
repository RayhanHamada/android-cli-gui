class AndroidCliGui < Formula
  desc "Unofficial GUI for the official Android CLI"
  homepage "https://github.com/RayhanHamada/android-cli-gui"
  version "__VERSION__"
  depends_on macos: :sequoia

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/RayhanHamada/android-cli-gui/releases/download/v__VERSION__/android-cli-gui-v__VERSION__-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA256_MACOS_ARM64__"
    else
      url "https://github.com/RayhanHamada/android-cli-gui/releases/download/v__VERSION__/android-cli-gui-v__VERSION__-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA256_MACOS_X86_64__"
    end
  end

  def install
    bin.install "android-cli-gui"
  end

  test do
    assert_path_exists bin/"android-cli-gui"
  end
end
